{
  "version": "4.0",
  "dataModelSchema": {
    "name": "ARB Dashboard Model",
    "description": "Power BI data model for ARB governance and compliance tracking",
    "tables": [
      {
        "name": "ARBReviewRequests",
        "source": {
          "type": "SharePointList",
          "siteUrl": "https://yourtenant.sharepoint.com/sites/ARB",
          "listName": "ARB Review Requests"
        },
        "columns": [
          { "name": "ID", "dataType": "Int64" },
          { "name": "Title", "dataType": "String" },
          { "name": "ReviewStatus", "dataType": "String" },
          { "name": "ArchitectureDomain", "dataType": "String" },
          { "name": "TOGAFPhase", "dataType": "String" },
          { "name": "ComplianceFramework", "dataType": "String" },
          { "name": "RiskLevel", "dataType": "String" },
          { "name": "ReviewDate", "dataType": "DateTime" },
          { "name": "Created", "dataType": "DateTime" }
        ]
      },
      {
        "name": "ComplianceTracking",
        "source": {
          "type": "SharePointList",
          "siteUrl": "https://yourtenant.sharepoint.com/sites/ARB",
          "listName": "Compliance Tracking"
        },
        "columns": [
          { "name": "ID", "dataType": "Int64" },
          { "name": "Title", "dataType": "String" },
          { "name": "Framework", "dataType": "String" },
          { "name": "ControlID", "dataType": "String" },
          { "name": "ComplianceStatus", "dataType": "String" },
          { "name": "LastAssessmentDate", "dataType": "DateTime" }
        ]
      },
      {
        "name": "ServiceDeployment",
        "source": {
          "type": "SharePointList",
          "siteUrl": "https://yourtenant.sharepoint.com/sites/ARB",
          "listName": "Service Deployment Tracking"
        },
        "columns": [
          { "name": "ID", "dataType": "Int64" },
          { "name": "ServiceName", "dataType": "String" },
          { "name": "DeploymentStage", "dataType": "String" },
          { "name": "Created", "dataType": "DateTime" }
        ]
      }
    ],
    "measures": [
      {
        "name": "Total ARB Requests",
        "expression": "COUNTROWS(ARBReviewRequests)",
        "formatString": "#,##0"
      },
      {
        "name": "Approved Requests",
        "expression": "CALCULATE(COUNTROWS(ARBReviewRequests), ARBReviewRequests[ReviewStatus] = \"Approved\")",
        "formatString": "#,##0"
      },
      {
        "name": "Approval Rate",
        "expression": "DIVIDE([Approved Requests], [Total ARB Requests], 0)",
        "formatString": "0.00%"
      },
      {
        "name": "High Risk Items",
        "expression": "CALCULATE(COUNTROWS(ARBReviewRequests), ARBReviewRequests[RiskLevel] IN {\"High\", \"Critical\"})",
        "formatString": "#,##0"
      },
      {
        "name": "Compliance Rate",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(ComplianceTracking), ComplianceTracking[ComplianceStatus] = \"Compliant\"), COUNTROWS(ComplianceTracking), 0)",
        "formatString": "0.00%"
      },
      {
        "name": "Active Services",
        "expression": "CALCULATE(COUNTROWS(ServiceDeployment), ServiceDeployment[DeploymentStage] <> \"Retired\")",
        "formatString": "#,##0"
      }
    ]
  },
  "pages": [
    {
      "name": "ARB Overview",
      "visualizations": [
        {
          "type": "card",
          "title": "Total ARB Requests",
          "measure": "Total ARB Requests",
          "position": { "x": 0, "y": 0, "width": 3, "height": 2 }
        },
        {
          "type": "card",
          "title": "Approval Rate",
          "measure": "Approval Rate",
          "position": { "x": 3, "y": 0, "width": 3, "height": 2 }
        },
        {
          "type": "card",
          "title": "High Risk Items",
          "measure": "High Risk Items",
          "position": { "x": 6, "y": 0, "width": 3, "height": 2 }
        },
        {
          "type": "pieChart",
          "title": "Requests by Status",
          "legend": "ReviewStatus",
          "values": "COUNTROWS(ARBReviewRequests)",
          "position": { "x": 0, "y": 2, "width": 4, "height": 4 }
        },
        {
          "type": "barChart",
          "title": "Requests by Architecture Domain",
          "axis": "ArchitectureDomain",
          "values": "COUNTROWS(ARBReviewRequests)",
          "position": { "x": 4, "y": 2, "width": 5, "height": 4 }
        },
        {
          "type": "lineChart",
          "title": "ARB Requests Trend",
          "axis": "ReviewDate",
          "values": "COUNTROWS(ARBReviewRequests)",
          "position": { "x": 0, "y": 6, "width": 9, "height": 4 }
        }
      ]
    },
    {
      "name": "TOGAF ADM Tracking",
      "visualizations": [
        {
          "type": "funnelChart",
          "title": "TOGAF ADM Phase Distribution",
          "category": "TOGAFPhase",
          "values": "COUNTROWS(ARBReviewRequests)",
          "position": { "x": 0, "y": 0, "width": 5, "height": 6 }
        },
        {
          "type": "table",
          "title": "TOGAF Phase Details",
          "columns": ["Title", "TOGAFPhase", "ArchitectureDomain", "ReviewStatus"],
          "position": { "x": 5, "y": 0, "width": 4, "height": 6 }
        },
        {
          "type": "gauge",
          "title": "Architecture Vision Completion",
          "measure": "DIVIDE(CALCULATE(COUNTROWS(ARBReviewRequests), ARBReviewRequests[TOGAFPhase] = \"Phase A: Architecture Vision\", ARBReviewRequests[ReviewStatus] = \"Approved\"), CALCULATE(COUNTROWS(ARBReviewRequests), ARBReviewRequests[TOGAFPhase] = \"Phase A: Architecture Vision\"), 0)",
          "min": 0,
          "max": 1,
          "position": { "x": 0, "y": 6, "width": 3, "height": 4 }
        }
      ]
    },
    {
      "name": "Compliance Dashboard",
      "visualizations": [
        {
          "type": "card",
          "title": "Overall Compliance Rate",
          "measure": "Compliance Rate",
          "position": { "x": 0, "y": 0, "width": 4, "height": 2 }
        },
        {
          "type": "barChart",
          "title": "Compliance by Framework",
          "axis": "Framework",
          "values": "COUNTROWS(ComplianceTracking)",
          "position": { "x": 4, "y": 0, "width": 5, "height": 4 }
        },
        {
          "type": "pieChart",
          "title": "Compliance Status Distribution",
          "legend": "ComplianceStatus",
          "values": "COUNTROWS(ComplianceTracking)",
          "position": { "x": 0, "y": 2, "width": 4, "height": 4 }
        },
        {
          "type": "matrix",
          "title": "Framework Compliance Matrix",
          "rows": "Framework",
          "columns": "ComplianceStatus",
          "values": "COUNTROWS(ComplianceTracking)",
          "position": { "x": 0, "y": 6, "width": 9, "height": 4 }
        },
        {
          "type": "table",
          "title": "NIST 800-53 Controls",
          "filter": "Framework = 'NIST 800-53'",
          "columns": ["ControlID", "ComplianceStatus", "LastAssessmentDate"],
          "position": { "x": 0, "y": 10, "width": 4, "height": 4 }
        },
        {
          "type": "table",
          "title": "FedRAMP Controls",
          "filter": "Framework = 'FedRAMP'",
          "columns": ["ControlID", "ComplianceStatus", "LastAssessmentDate"],
          "position": { "x": 4, "y": 10, "width": 5, "height": 4 }
        }
      ]
    },
    {
      "name": "Service Deployment",
      "visualizations": [
        {
          "type": "card",
          "title": "Active Services",
          "measure": "Active Services",
          "position": { "x": 0, "y": 0, "width": 3, "height": 2 }
        },
        {
          "type": "funnelChart",
          "title": "Deployment Pipeline",
          "category": "DeploymentStage",
          "values": "COUNTROWS(ServiceDeployment)",
          "position": { "x": 3, "y": 0, "width": 6, "height": 6 }
        },
        {
          "type": "table",
          "title": "Service Deployment Details",
          "columns": ["ServiceName", "DeploymentStage", "Created"],
          "position": { "x": 0, "y": 6, "width": 9, "height": 4 }
        }
      ]
    }
  ],
  "refreshSchedule": {
    "enabled": true,
    "frequency": "Daily",
    "time": "06:00"
  }
}
